@model Review
@{
    ViewData["Title"] = "Создание товара";
    var product = ViewBag.Product as SouvenirShop.Models.Souvenir;
    var my_name = Context.Session.GetString("username");
    var existingReviews = ViewBag.ExistingReviews as List<SouvenirShop.Models.Review>;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Сувенирный магазин</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="debug_center_items">
    <header>
        <h1>Ваш отзыв</h1>
    </header>
    <main class="ProfileViewer">
        <h3>Оставить отзыв</h3>
        <form asp-asp-controller="Home" asp-action="Add_Review" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <input type="hidden" asp-for="ProductId" />
        
            <div class="form-group mb-3">
                <label asp-for="Author_name" class="form-label">Ваше имя</label>
                <input asp-for="Author_name" class="form-control" />
                <span asp-validation-for="Author_name" class="text-danger"></span>
            </div>
        
            <div class="form-group mb-3">
                <label asp-for="Rating" class="form-label">Оценка</label>
                <select asp-for="Rating" class="form-select">
                    <option value="5">5 - Отлично</option>
                    <option value="4">4 - Хорошо</option>
                    <option value="3">3 - Средне</option>
                    <option value="2">2 - Так себе</option>
                    <option value="1">1 - Плохо</option>
                </select>
            </div>
        
            <div class="form-group mb-3">
                <label asp-for="Text" class="form-label">Комментарий</label>
                <textarea asp-for="Text" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Text" class="text-danger"></span>
            </div>
        
            <button type="submit" class="btn btn-primary">Отправить</button>
        </form>
        <h3>Отзывы клиентов</h3>
            @if (existingReviews == null || !existingReviews.Any())
            {
                <p class="text-muted">Отзывов пока нет.</p>
            }
            else
            {
                <div class="reviews-list mb-4">
                    @foreach (var review in existingReviews)
                    {
                        <div class="card mb-2">
                            <div class="card-body">
                                <h5 class="card-title">@review.Author_name</h5>
                                <p class="card-text text-warning">@string.Concat(Enumerable.Repeat("★", review.Rating ?? 0))</p>
                                <p class="card-text">@review.Text</p>
                            </div>
                        </div>
                    }
                </div>
            }
    </main>
    <footer>
        <p>Контакты: shop@example.com</p>
        <div class="support-form">
            <h2>Оставьте заявку в службу поддержки</h2>
            <p>Мы ценим каждого покупателя и всегда рады ответить на ваши вопросы и пожелания!</p>
            <form action="#" method="post">
                <label for="name">Ваше имя:</label>
                <input type="text" id="name" name="name" placeholder="введите ваше имя" required>
                <label for="email">E-mail:</label>
                <input type="email" id="email" name="email" placeholder="введите ваш email" required>
                <label for="subject">Тема обращения:</label>
                <input type="text" id="subject" name="subject" placeholder="Тема обращения" required>
                <label for="message">Ваше обращение:</label>
                <textarea id="message" name="message" rows="5" placeholder="Опишите суть вопроса или предложения" required></textarea>
                <button type="submit">Отправить заявку</button>
            </form>
        </div>
    </footer>
</body>
</html>