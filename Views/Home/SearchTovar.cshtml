@model IEnumerable<Souvenir>
@{
    ViewData["Title"] = "Home Page";
    var context = Context.Session.GetString("corzina");
    var accounts_check = Context.Session.GetString("username");
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Сувенирный магазин</title>
    <link rel="stylesheet" href="css/site.css" />
</head>
<body>
    <header class="rounded-bottom-3 my-joined-block">
        <h1>Сувенирный магазин SouvenirShop</h1>
        <form asp-asp-controller="Home" asp-action="SearchTovar" method="get" class="d-flex gap-2 my-small-element">
            <div class="input-group ">
                <input type="text" id="SearchedTovar" name="SearchedTovar" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Поиск товаров по названию или описанию..." />
                <button type="submit" class="btn btn-primary">
                    🔍 Искать
                </button>
            </div>
            
            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
            }
        </form>
    </header>
    <main>
        @foreach (Souvenir souvenir in Model)
        {
            <div class="card">
                <img src="@souvenir.ImageUrl" alt="картинка не найдена">
                <h2>@souvenir.name</h2>
                <p>Цена @souvenir.Price руб.</p>
                <p>Описание: @souvenir.Description</p>
                <div class="mt-2 text-center">
                    @if (!string.IsNullOrEmpty(Context.Session.GetString("username"))){
                    <form method="post" action="/Home/AddObjectToList" class="add_remove">
                        <input type="hidden" name="Id" value="@souvenir.id" />
                        <button type="submit" class="profile_option">В корзину</button>
                    </form>
                    <a asp-controller="Home"
                       asp-action="AddReview"
                       asp-route-id="@souvenir.id"
                       class="profile_option">
                       Смотреть отзывы
                    </a>
                    }
                    @if(accounts_check == "Administrator_man"){
                        <form asp-controller="Home" asp-action="Delete_Tovar_to_site" asp-route-id="@souvenir.id" method="post" style="margin-top: 10px;">
                            <button type="submit" class="profile_option" onclick="return confirm('Вы уверены, что хотите удалить этот товар?');">
                                Удалить товар
                            </button>
                        </form>
                        <a class="profile_option" asp-area="" asp-controller="Home" asp-action="Remake_tovar" asp-route-id="@souvenir.id">Редактировать товар</a>

                    }
                </div>
            </div>
        }
    </main>
    <footer>
        <p>Контакты: shop@example.com</p>
        <div class="support-form">
            <h2>Оставьте заявку в службу поддержки</h2>
            <p>Мы ценим каждого покупателя и всегда рады ответить на ваши вопросы и пожелания!</p>
            <form action="#" method="post">
                <label for="name">Ваше имя:</label>
                <input type="text" id="name" name="name" placeholder="введите ваше имя" required>
                <label for="email">E-mail:</label>
                <input type="email" id="email" name="email" placeholder="введите ваш email" required>
                <label for="subject">Тема обращения:</label>
                <input type="text" id="subject" name="subject" placeholder="Тема обращения" required>
                <label for="message">Ваше обращение:</label>
                <textarea id="message" name="message" rows="5" placeholder="Опишите суть вопроса или предложения" required></textarea>
                <button type="submit">Отправить заявку</button>
            </form>
        </div>
    </footer>
</body>
</html>